local.file_match "tusd_logs" {
  path_targets = [{"__path__" = "/var/log/tusd/*"}]
}

loki.source.file "telemetry_files" {
  targets    = local.file_match.tusd_logs.targets
  forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}