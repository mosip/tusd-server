local.file_match "tusd_logs" {
  path_targets = [{"__path__" = "/var/log/tusd/*"}]
}
discovery.relabel "exclude_info_sidecars" {
  targets = local.file_match.tusd_logs.targets
  
  rule {
    target_label = "job"
    replacement  = "tusd_logs"
  }
  
  rule {
    source_labels = ["__path__"]
    regex         = ".*\\.info$"
    action        = "drop"
  }
}

loki.source.file "telemetry_files" {
  targets    = discovery.relabel.exclude_info_sidecars.output
  forward_to = [loki.process.tusd_logs.receiver]
}

loki.process "tusd_logs"{
  // 1. Parse outer JSON envelope to extract level and stringified message payload
  stage.json{
    expressions={
      level="level",
      message="message",
    }
  }
  
  // 2. Parse inner JSON inside 'message' to extract metric name and value
  stage.json{
    source= "message"
    expressions = {
      name= "name",
      value="value",
    }
  }

  // 3. Promote low-cardinality fields to labels (keeping 'value' out to protect Loki index)
  stage.labels {
    values={
      level="",
      name="",
    }
  }

  // 4. Drop malformed log lines that failed JSON extraction
  stage.drop{
    source= "level"
    expression="^$"

  }

  forward_to=[loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
